# Modèle de /srv/canapact/.env sur le VPS (droits 600, propriétaire : deploy).
# Ne jamais commiter le vrai fichier.

# Mot de passe Postgres. Générer : openssl rand -hex 32 (hexadécimal : pas de
# caractère à échapper dans l'URL de connexion).
POSTGRES_PASSWORD=

# Secret des JWT. Générer : openssl rand -base64 48
JWT_SECRET=

APP_URL=https://canapact.fr
# Port local du conteneur web, relayé par le Nginx du VPS.
WEB_PORT=8080
AUTH_RATE_LIMIT=10
MEDIA_RATE_LIMIT=30

# Emails transactionnels (Brevo). L'expéditeur doit être un domaine validé chez Brevo.
MAIL_TRANSPORT=brevo
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=Canapact
BREVO_API_KEY=
# Emails par jour au plus (Brevo gratuit : 300). Défaut : 280.
# MAIL_DAILY_LIMIT=280

# « Se connecter avec Google » (facultatif, les deux ou aucun).
# URI de redirection : https://canapact.fr/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Durée des vidéos YouTube (facultatif).
# YOUTUBE_API_KEY=
