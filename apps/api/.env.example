PORT=3000
DATABASE_URL=postgresql://watchlist:watchlist@localhost:5432/watchlist
APP_URL=http://localhost:5173

# Secret des JWT d'accès. Générer : openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# Navigateurs : localhost compte comme sécurisé, true fonctionne aussi en dev.
COOKIE_SECURE=true
# Derrière le Nginx du VPS : TRUST_PROXY=loopback (ou 1)
TRUST_PROXY=false
AUTH_RATE_LIMIT=10

# console (dev, emails dans les logs) | memory (tests) | brevo (prod)
MAIL_TRANSPORT=console
MAIL_FROM_EMAIL=bonjour@canapact.local
MAIL_FROM_NAME=Canapact
# BREVO_API_KEY=

