PORT=3000
DATABASE_URL=postgresql://watchlist:watchlist@localhost:5432/watchlist
APP_URL=http://localhost:5173

# Secret des JWT d'accès. Générer : openssl rand -base64 48
JWT_SECRET=dev-only-change-me-dev-only-change-me-dev-only
# Navigateurs : localhost compte comme sécurisé, true fonctionne aussi en dev.
COOKIE_SECURE=true
# Derrière le Nginx du VPS : TRUST_PROXY=loopback (ou 1)
TRUST_PROXY=false
AUTH_RATE_LIMIT=10

# console (dev, emails dans les logs) | memory (tests) | brevo (prod)
MAIL_TRANSPORT=console
MAIL_FROM_EMAIL=bonjour@canapact.local
MAIL_FROM_NAME=Canapact
# BREVO_API_KEY=
# Emails par jour au plus (Brevo gratuit : 300). Au-delà : « réessayez demain ».
# MAIL_DAILY_LIMIT=280

# « Se connecter avec Google » (facultatif : sans ces deux valeurs, le bouton est masqué).
# Console Google Cloud > Identifiants > ID client OAuth « Application Web ».
# URI de redirection autorisée : ${APP_URL}/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Durée des vidéos YouTube (facultatif : sans clé, l'ajout marche mais sans durée).
# Console Google Cloud > API « YouTube Data API v3 » > Identifiants > Clé API.
# Restreindre la clé à cette API. Quota gratuit : 10 000 unités/jour (1 par ajout).
# YOUTUBE_API_KEY=
# Aperçus et ajouts de liens par utilisateur et par minute.
MEDIA_RATE_LIMIT=30
# Quota YouTube par jour réservé à la synchro des playlists (sur 10 000).
# PLAYLIST_SYNC_DAILY_UNITS=6000
# Part de ce quota qu'un même groupe peut dépenser par jour.
# PLAYLIST_SYNC_GROUP_DAILY_UNITS=500
